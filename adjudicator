"""JAX-native multi-agent proposal and adjudication loop with agent interaction.

Agents first form independent proposals, then perform one round of soft
communication (agent-to-agent attention) before the final heads and
adjudication. Pure-JAX memory only.
"""

from __future__ import annotations

from dataclasses import dataclass
from math import ceil
from typing import Any, Callable, NamedTuple, Optional

import jax
import jax.numpy as jnp
import numpy as np
from jax import lax, random

from jax_quantum_memory import JAXQuantumMemoryField
