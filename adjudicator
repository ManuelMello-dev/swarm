    init_qpso, qpso_step, role_rotation_update, QPSOState,
)

ARC_HYPOTHESIS_LABELS = (
    "translation_or_motion",
    "reflection_or_rotation",
    "recoloring",
    "object_count_or_shape",
    "symmetry_or_repetition",
    "sequence_or_periodicity",
    "object_interaction_or_mechanics",
    "unknown_or_other",
)


@dataclass(frozen=True)
class SwarmConfig:
    max_agents: int = 32
    min_agents: int = 2
    chunk_size: int = 8
    grid_side: int = 16
    hidden_dim: int = 64
    num_hypotheses: int = 8
    num_actions: int = 6
    num_colors: int = 10
    graph_capacity: int = 128
    retrieval_top_k: int = 8
    graph_action_prior_weight: float = 0.5
    memory_budget_mb: float = 256.0
    cross_task_weight: float = 0.25
    use_phi_drift: bool = True
    policy_learning_rate: float = 0.025
    reliability_learning_rate: float = 0.05
    value_learning_rate: float = 0.005
    prediction_learning_rate: float = 0.001
    coordinate_learning_rate: float = 0.05
    trunk_learning_rate: float = 0.002
    relative_emotional_weight: bool = True
    surprise_ema_decay: float = 0.95
    emotional_floor: float = 0.05
    trunk_grad_clip_norm: float = 1.0
    baseline_decay: float = 0.95
    quantum_memory_dim: int = 32
    quantum_memory_capacity: int = 1000
    quantum_memory_top_k: int = 5
    quantum_projection_learning_rate: float = 0.005
    quantum_projection_update_every: int = 8
    seed: int = 0
    num_roles: int = 4
    qpso_particles: int = 6
    qpso_every: int = 4
    qpso_beta: float = 0.7
    qpso_init_scale: float = 0.03
    rotation_every: int = 2
    rotation_theta_max: float = 0.06

    def __post_init__(self) -> None:
        positive = {
            "max_agents": self.max_agents, "min_agents": self.min_agents,
            "chunk_size": self.chunk_size, "grid_side": self.grid_side,
            "hidden_dim": self.hidden_dim, "num_hypotheses": self.num_hypotheses,
            "num_actions": self.num_actions, "num_colors": self.num_colors,
            "graph_capacity": self.graph_capacity, "retrieval_top_k": self.retrieval_top_k,
            "quantum_memory_dim": self.quantum_memory_dim,
            "quantum_memory_capacity": self.quantum_memory_capacity,
            "quantum_memory_top_k": self.quantum_memory_top_k,
            "quantum_projection_update_every": self.quantum_projection_update_every,
            "num_roles": self.num_roles, "qpso_particles": self.qpso_particles,
            "qpso_every": self.qpso_every, "rotation_every": self.rotation_every,
        }
        bad = [name for name, value in positive.items() if value <= 0]
        if bad:
            raise ValueError(f"positive configuration values required: {', '.join(bad)}")
        if self.min_agents > self.max_agents:
            raise ValueError("min_agents cannot exceed max_agents")
        if self.retrieval_top_k > self.graph_capacity:
            raise ValueError("retrieval_top_k cannot exceed graph_capacity")
        if self.num_actions != 6:
            raise ValueError("ARC proposal head currently supports exactly ACTION1..ACTION6")
        if self.num_colors != 10:
            raise ValueError("ARC palette must contain exactly 10 colors")
        if self.memory_budget_mb <= 0:
            raise ValueError("memory_budget_mb must be positive")
        if self.quantum_projection_learning_rate <= 0:
            raise ValueError("quantum_projection_learning_rate must be positive")
        if self.trunk_grad_clip_norm <= 0:
            raise ValueError("trunk_grad_clip_norm must be positive")
        for name in (
            "cross_task_weight", "graph_action_prior_weight",
            "policy_learning_rate", "reliability_learning_rate",
            "value_learning_rate", "prediction_learning_rate", "coordinate_learning_rate",
            "trunk_learning_rate", "baseline_decay",
            "surprise_ema_decay", "emotional_floor",
            "quantum_projection_learning_rate", "qpso_beta", "qpso_init_scale",
            "rotation_theta_max",
        ):
            value = getattr(self, name)
            if not 0.0 <= value <= 1.0:
                raise ValueError(f"{name} must be in [0, 1]")

    @property
    def patch_count(self) -> int:
        return self.grid_side * self.grid_side

    @property
    def hypothesis_labels(self) -> tuple[str, ...]:
        base = list(ARC_HYPOTHESIS_LABELS[: self.num_hypotheses])
        base.extend(f"hypothesis_{i}" for i in range(len(base), self.num_hypotheses))
        return tuple(base)


