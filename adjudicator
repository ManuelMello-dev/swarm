def estimate_working_set_bytes(config: SwarmConfig, agent_count: int) -> int:
    if agent_count < 1:
        return 2**63 - 1
    pad = int(ceil(agent_count / config.chunk_size) * config.chunk_size)
    p, h, k, c, g, a = (
        config.patch_count, config.hidden_dim, config.num_hypotheses,
        config.num_colors, config.graph_capacity, config.num_actions,
    )
    graph_elements = g * (h + 2 * p + p * c + k + 12) + g * g
    shared_elements = (
        (c + 2) * h
        + (2 * h + c + 2 * config.quantum_memory_dim + 10) * h
        + (h + p + k) * h
        + 4 * h * h
        + h * a + a * h + h * k + 2 * h + h + h * p + h * p * c
        + pad * (h + a + k)
        + h + 1
        + 4 * h * h  # communication
    )
    per_agent_elements = h * 2 + p * 2 + p * c + k + 3 * a + a * p + a * p * c + 4
    proposal_elements = pad * per_agent_elements
    token_elements = p * (c + 2 + h)
    # Retained trunk inputs plus gradient recomputation (~3x trunk activations).
    trunk_elements = 3 * (p * h + p + h + pad * (2 * h + p)) + 8 * h * h
    return int(2 * (4 * (
        graph_elements + shared_elements + proposal_elements + token_elements + trunk_elements
    )))


def _padded_count(agent_count: int, chunk_size: int) -> int:
    return int(ceil(agent_count / chunk_size) * chunk_size)


def _agent_cap_for_budget(config: SwarmConfig) -> int:
    limit = int(config.memory_budget_mb * 1024 * 1024)
    for count in range(config.max_agents, config.min_agents - 1, -1):
        if estimate_working_set_bytes(config, count) <= limit:
            return count
    return 0


def choose_active_count(
    novelty: float, uncertainty: float, disagreement: float,
    legal_action_count: int, minimum: int, maximum: int, num_actions: int = 6,
) -> int:
    if minimum < 1 or maximum < minimum:
        raise ValueError("require 1 <= minimum <= maximum")
    clamp = lambda v: float(np.clip(float(v), 0.0, 1.0))
    branch = (max(1, min(num_actions, int(legal_action_count))) - 1) / max(1, num_actions - 1)
    demand = (
        0.30 * clamp(novelty) + 0.30 * clamp(uncertainty)
        + 0.25 * clamp(disagreement) + 0.15 * clamp(branch)
    )
    return int(np.clip(minimum + round((maximum - minimum) * demand), minimum, maximum))


def _init_params(key: jax.Array, config: SwarmConfig, padded: int) -> SwarmParams:
    h, p, k, c, a = (
        config.hidden_dim, config.patch_count, config.num_hypotheses,
        config.num_colors, config.num_actions,
    )
    keys = random.split(key, 22)

    def mat(i: int, rows: int, cols: int) -> jax.Array:
        return random.normal(keys[i], (rows, cols), dtype=jnp.float32) / jnp.sqrt(float(max(1, rows)))

    role_ids = jnp.arange(padded) % config.num_roles
    role_bias_table = random.normal(keys[15], (config.num_roles, k), dtype=jnp.float32) * 0.3
    agent_role_bias = role_bias_table[role_ids]

    return SwarmParams(
        token_projection=mat(0, c + 2, h),
        global_projection=mat(1, 2 * h + c + 2 * config.quantum_memory_dim + 10, h),
        graph_projection=mat(2, h + p + k, h),
        key_projection=mat(3, h, h),
        query_projection=mat(4, h, h),
        recurrent_projection=mat(5, h, h),
        evidence_projection=mat(6, h, h),
        action_projection=mat(7, h, a),
        action_effect=mat(14, a, h),
        hypothesis_projection=mat(8, h, k),
        coordinate_projection=mat(9, h, 2),
        confidence_projection=mat(10, h, 1),
        change_projection=mat(11, h, p),
        color_projection=mat(12, h, p * c),
        agent_identity=random.normal(keys[13], (padded, h), dtype=jnp.float32) * 0.08,
        agent_action_bias=jnp.zeros((padded, a), dtype=jnp.float32),
        agent_role_bias=agent_role_bias,
        baseline_weights=jnp.zeros((h,), dtype=jnp.float32),
        baseline_bias=jnp.array(0.0, dtype=jnp.float32),
        comm_query=mat(16, h, h),
        comm_key=mat(17, h, h),
        comm_value=mat(18, h, h),
        comm_gate=mat(19, h, h),
    )


